---
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: object;
}

const {
  title,
  description = "Personal website of Bram de Vries",
  type = "website",
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/assets/og-image.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bram de Vries, Software Developer" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="BRDV" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@_brdv" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="BRDV Blog"
      href={new URL("/rss.xml", Astro.site)}
    />

    <title>{title}</title>

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            ...jsonLd,
          })}
        />
      )
    }

    <!-- Theme detection script - runs before page render to prevent flash -->
    <script is:inline>
      function getTheme() {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      }

      const theme = getTheme();
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <div class="container">
      <div class="layout">
        <Header />
        <main class="main-content">
          <slot />
          <Footer />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 0 2rem;
  }

  .layout {
    display: flex;
    min-height: 100vh;
    gap: 3rem;
  }

  .main-content {
    flex: 1;
    padding: 2rem 0;
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .container {
      max-width: 800px;
      padding: 0 1.5rem;
    }

    .layout {
      gap: 2rem;
    }

    .main-content {
      padding: 2rem 0;
    }
  }

  @media (max-width: 768px) {
    .container {
      max-width: 100%;
      padding: 0;
    }

    .layout {
      flex-direction: column;
      gap: 0;
    }

    .main-content {
      padding: 2rem 1.5rem;
    }
  }
</style>
